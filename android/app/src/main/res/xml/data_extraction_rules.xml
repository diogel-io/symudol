<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing Symudol stores leaves the phone through backup or device transfer (SR-22, #15): the
  vault, remembered decisions and NIP-46 session keys. Keys move only through an export the user
  asks for. allowBackup="false" covers Android 11 and below; on Android 12+ it stops cloud backup
  but not device-to-device transfer, so these rules exclude every domain from both.
  See documentation/backup-and-screen-capture-decision.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

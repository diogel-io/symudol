# The Gradle wrapper (gradlew, gradlew.bat, gradle/wrapper/gradle-wrapper.jar) is committed, so
# every build uses Gradle 9.3.1's launcher instead of the older one Flutter would otherwise copy
# in; Flutter never overwrites an existing wrapper (#148).
/.gradle
/captures/
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
**/*.p12
